      "rule": "A build of an api-plan plan gets a panel on its diff."
    },
    {
      "id": "push",
      "rule": "A push that changes a public API or deletes behavior gets a panel on its diff first."
    },
    {
      "id": "external-pr",
      "rule": "Someone else's PR, asked for as \"review PR <number>\", gets a review-only panel on its diff, briefed with its body, linked issue and plan."
